# ----------------------------------------------------------------------------------------------------------------------------------------------------------------
# .env.example
# ----------------------------------------------------------------------------------------------------------------------------------------------------------------
# UNIVERSIDAD DEL VALLE DE GUATEMALA
# Redes
#
# Descripcion: Plantilla de las variables de entorno del proyecto. Copiar este archivo como .env y completar los valores.
#
# Autor:         Andre Emilio Pivaral Lopez
# Fecha:         26 de Agosto de 2026
# ----------------------------------------------------------------------------------------------------------------------------------------------------------------

# Clave de la API del modelo de lenguaje, obtenida desde la consola del proveedor
ANTHROPIC_API_KEY=

# Modelo a utilizar; verificar el identificador vigente en la documentacion de la API
MODELO_LLM=claude-haiku-4-5-20251001

# Endpoint y version de la API de mensajes
URL_API_LLM=https://api.anthropic.com/v1/messages
VERSION_API_LLM=2023-06-01

# Parametros de generacion del modelo
MAX_TOKENS=2048
TEMPERATURA=0.4
TIEMPO_ESPERA_LLM=120

# Version del protocolo MCP que el anfitrion solicita durante la negociacion
VERSION_PROTOCOLO=2025-06-18
NOMBRE_CLIENTE=anfitrion-uvg-redes
VERSION_CLIENTE=1.0.0
TIEMPO_ESPERA_MCP=90

# Cantidad maxima de ciclos de invocacion de herramientas por cada consulta
MAX_ITERACIONES_HERRAMIENTAS=8

# Rutas de trabajo relativas a la raiz del proyecto
ARCHIVO_SERVIDORES=servidores.json
DIRECTORIO_BITACORA=bitacora
ESPACIO_TRABAJO=espacio_trabajo

# Direccion del servidor MCP remoto desplegado en la nube
URL_MCP_REMOTO=https://farmacia-mcp.onrender.com/mcp